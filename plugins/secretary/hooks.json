{
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node ~/.claude/the-secretary/summarize.mjs user-prompt",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node ~/.claude/the-secretary/summarize.mjs incremental",
          "timeout": 60
        }
      ]
    }
  ],
  "PreCompact": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "bash ~/.claude/the-secretary/start-llm.sh start > /dev/null 2>&1; node ~/.claude/the-secretary/summarize.mjs compact",
          "timeout": 15
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node ~/.claude/the-secretary/summarize.mjs force --stop-llm",
          "timeout": 15
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "node ~/.claude/the-secretary/summarize.mjs force --stop-llm --notify",
          "timeout": 15
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "matcher": "startup|resume",
      "hooks": [
        {
          "type": "command",
          "command": "bash ~/.claude/the-secretary/start-llm.sh start > /dev/null 2>&1; node ~/.claude/the-secretary/summarize.mjs restore; node ~/.claude/the-secretary/summarize.mjs sync",
          "timeout": 120
        }
      ]
    },
    {
      "matcher": "clear",
      "hooks": [
        {
          "type": "command",
          "command": "bash ~/.claude/the-secretary/start-llm.sh start > /dev/null 2>&1; node ~/.claude/the-secretary/summarize.mjs restore; node ~/.claude/the-secretary/summarize.mjs sync",
          "timeout": 120
        },
        {
          "type": "command",
          "command": "node ~/.claude/the-secretary/summarize.mjs await-handoff --rewake",
          "async": true,
          "asyncRewake": true,
          "rewakeSummary": "The Secretary: previous session handoff",
          "rewakeMessage": "The Secretary finished waiting for the previous session's handoff after /clear. Tell the user in one line what arrived. Then check the 'End of the previous conversation' block injected at session start: if it shows work left unfinished, say in one line what was pending and offer to resume it; otherwise wait for their request:",
          "timeout": 600
        }
      ]
    }
  ]
}
